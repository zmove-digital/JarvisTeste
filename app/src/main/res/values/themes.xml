<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema escuro desde o primeiro frame: sem flash branco na abertura. -->
    <style name="Theme.JarvisTeste" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#02070C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Splash do sistema (Android 12+): fundo e ícone animados em ciano. -->
        <item name="android:windowSplashScreenBackground">#02070C</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#020A10</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>

    <style name="Theme.JarvisTeste.Splash" parent="Theme.JarvisTeste">
        <item name="android:windowBackground">#02070C</item>
    </style>

    <!-- Fundo escuro desde o primeiro frame: evita um flash branco quando o
         avatar é aberto sobre a tela de bloqueio. -->
    <style name="Theme.JarvisTeste.Avatar" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
</resources>
