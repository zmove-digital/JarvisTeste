<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Só existe na variante debug: permite disparar o avatar pelo ADB para
         testar o despertar da tela sem precisar falar a palavra de ativação. -->
    <application>
        <receiver
            android:name=".debug.DebugAvatarReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.jarvisteste.DEBUG_AVATAR" />
            </intent-filter>
        </receiver>

        <!-- Dispara uma fala de teste pelo ADB, usando os ajustes salvos. -->
        <receiver
            android:name=".debug.DebugSpeakReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.jarvisteste.DEBUG_SPEAK" />
            </intent-filter>
        </receiver>

        <!-- Envia um comando ao Gemini (com as ações do aparelho) para testar as
             ferramentas sem falar: use o extra "text" com o comando desejado. -->
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.jarvisteste.DEBUG_COMMAND" />
                <action android:name="com.example.jarvisteste.DEBUG_WEATHER" />
                <action android:name="com.example.jarvisteste.DEBUG_MODELS" />
                <action android:name="com.example.jarvisteste.DEBUG_PROBE" />
                <action android:name="com.example.jarvisteste.DEBUG_INTERACTIONS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
